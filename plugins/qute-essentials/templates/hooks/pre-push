#!/usr/bin/env bash
# qute-pre-push-dispatcher v1 — stamped by /setup-qute-repo (do not hand-edit;
# add your own hooks to pre-push.d/ instead).
#
# Git gives a pre-push hook the refs it is about to send on STDIN, and stdin
# can only be consumed once. So this dispatcher reads the ref lines exactly
# once and replays them to each consumer:
#
#   1. the qute branch guard at <repo>/.claude/hooks/pre-push-branch-guard
#      (first, and fatal — a refused destination stops the push immediately);
#   2. every executable in <hooks dir>/pre-push.d/, in lexical order. A repo
#      that already had its own pre-push hook when the guard was installed will
#      find it there as 00-legacy-pre-push; pre-commit's generated shim, if it
#      held the slot, as 50-pre-commit.
#
# The guard MUST see the full, unfiltered stdin, so it always runs from a
# native hook path — never as a pre-commit `pre-push`-stage hook, which never
# sees branch deletions and judges a multi-ref push on its first ref alone.
#
# Bypass (all of it): git push --no-verify
set -uo pipefail

hooks_dir="$(cd "$(dirname "$0")" && pwd)"
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"

# Read stdin once. `$(cat)` strips trailing newlines, which is why replay uses
# printf with an explicit newline — and skips it entirely when there is no
# input, so a consumer never sees a spurious blank line.
refs="$(cat)"
emit() { [ -n "$refs" ] && printf '%s\n' "$refs"; return 0; }

guard="${repo_root:-.}/.claude/hooks/pre-push-branch-guard"
config="${repo_root:-.}/.claude/git-guard.json"

if [ -x "$guard" ]; then
  emit | "$guard" "$@" || exit $?
elif [ -e "$config" ] || [ -L "$config" ]; then
  # The repo is opted in — that config file is somebody stating they want this
  # branch-guarded — but the guard script is missing or not executable. Skipping
  # it silently would be the exact failure this whole hook exists to prevent: a
  # repo that looks protected and is not.
  #
  # This is not hypothetical. The dispatcher lives in the hooks dir, which git
  # does not track; the guard script lives in `.claude/`, which it does. Check
  # out a branch from before the guard was added, or lose the exec bit to a
  # `cp` without -p, and the dispatcher keeps running while the guard is gone.
  if [ -e "$guard" ]; then
    reason="exists but is not executable"
    fix="chmod +x \"\$(git rev-parse --show-toplevel)/.claude/hooks/pre-push-branch-guard\""
  else
    reason="is missing"
    fix="re-run: python3 <qute-essentials>/scripts/install_pre_push_guard.py --repo ."
  fi
  cat >&2 <<EOF

pre-push: REFUSED — this repo is opted in to the branch guard, but the guard
itself ${reason}:

    ${guard}

Refusing rather than letting the push through unchecked: ${config} says these
branches are meant to be protected, so an absent guard is a broken install, not
permission to proceed.

  ${fix}

To override deliberately:

    git push --no-verify …

EOF
  exit 1
fi

status=0
if [ -d "$hooks_dir/pre-push.d" ]; then
  for hook in "$hooks_dir"/pre-push.d/*; do
    [ -x "$hook" ] || continue
    # `pre-commit install --hook-type pre-push` reclaims the hook slot and
    # moves this dispatcher to <slot>.legacy — which its shim runs FIRST, with
    # the raw stdin, ORing our exit code into its own, so the guard keeps full
    # fidelity. But pre-commit is then about to run its own hooks anyway, and a
    # shim adopted at install time is sitting in pre-push.d/. Skip it in that
    # case or the repo's pre-commit hooks run twice per push. pre-commit sets
    # PRE_COMMIT_RUNNING_LEGACY=1 when it invokes us.
    if [ -n "${PRE_COMMIT_RUNNING_LEGACY:-}" ] &&
       grep -qsi 'generated by pre-commit' "$hook"; then
      continue
    fi
    emit | "$hook" "$@" || status=$?
  done
fi

exit "$status"
